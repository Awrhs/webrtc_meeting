# ============================================
# Server Configuration
# ============================================
SERVER_PORT=8080
SFU_PORT=8081

# ============================================
# WSL2 Development Configuration
# ============================================
# Enable WSL2 compatibility mode when running SFU in WSL2
# This will auto-detect WSL2's real IP (172.x.x.x) and announce it in ICE candidates
# Frontend should use this IP in VITE_SFU_HOST
WSL2_COMPAT=0
# Manually specify WSL2 IP if auto-detect fails (get from `wsl hostname -I`)
# WSL2_IP=172.25.24.77

# ============================================
# gRPC SFU Control Configuration
# ============================================
# API server connects to SFU via gRPC for control commands
# Single node: localhost:50051
# Cluster mode: use load balancer address
SFU_ADDR=localhost:50051

# ============================================
# SFU Callback Configuration (for SFU -> API)
# ============================================
# API server host for SFU connection failure callback
# Docker network: http://api-server:8080
# Local development: http://localhost:8080
API_SERVER_HOST=http://api-server:8080

# ============================================
# WebRTC Configuration
# ============================================
# Optional: Fix WebRTC UDP port range (useful for Docker port mapping)
# WEBRTC_PORT_RANGE_MIN=49152
# WEBRTC_PORT_RANGE_MAX=49200

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=conference

# ============================================
# Redis Configuration
# ============================================
# Redis is used for:
# 1. Hot data cache (room info, user info)
# 2. Online status tracking
# 3. Room member count cache
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# ============================================
# JWT Authentication Configuration
# ============================================
# !!! IMPORTANT: Change this in production !!!
# Generate a strong random secret for JWT signing
JWT_SECRET=your-secret-key-change-in-production
# Token expiry in hours (default: 7 days)
JWT_EXPIRY_HOURS=168

# ============================================
# Coturn STUN/TURN Configuration
# ============================================
# STUN/TURN servers for WebRTC NAT traversal
# Multiple servers can be configured comma-separated
COTURN_URL=turn:coturn:3478
COTURN_USER=username
COTURN_PASSWORD=password

# ============================================
# E2EE (End-to-End Encryption) Configuration
# ============================================
# E2EE enables AES-256-GCM encrypted private messages
# Public keys are stored in database for key exchange
E2EE_ENABLED=true
