# ============================================
# Runtime
# ============================================
GO_ENV=development
SERVER_PORT=8080
SFU_PORT=8081
SFU_GRPC_PORT=50051
SFU_ADDR=localhost:50051
API_SERVER_HOST=http://localhost:8080

# ============================================
# Database (PostgreSQL)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=conference

# ============================================
# Redis
# ============================================
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# ============================================
# JWT / SFU Auth
# Production must use strong independent random values.
# ============================================
JWT_SECRET=your-secret-key-change-in-production
SFU_JWT_SECRET=your-sfu-secret-key-change-in-production
SFU_CONTROL_TOKEN=dev-sfu-control-token
SFU_CALLBACK_TOKEN=dev-sfu-callback-token
JWT_EXPIRY_HOURS=168
SFU_TOKEN_EXPIRY_MINUTES=5

# ============================================
# CORS / WebSocket Origins
# Comma-separated exact origins. Do not use * in production.
# ============================================
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1
SFU_ALLOW_UNAUTHENTICATED_DEV=false

# ============================================
# STUN/TURN
# Docker network default: turn:coturn:3478
# Local host default: turn:localhost:3478
# ============================================
COTURN_URL=turn:localhost:3478
COTURN_USER=username
COTURN_PASSWORD=password
TURN_STATIC_AUTH_SECRET=dev-turn-secret-change-in-production

# Optional WebRTC UDP range for deployments that need fixed firewall rules.
WEBRTC_PORT_RANGE_MIN=49152
WEBRTC_PORT_RANGE_MAX=49200

# ============================================
# HTTP lifecycle
# ============================================
HTTP_READ_TIMEOUT_SECONDS=10
HTTP_WRITE_TIMEOUT_SECONDS=10
SHUTDOWN_TIMEOUT_SECONDS=15

# ============================================
# Rate limits
# ============================================
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_WS_PER_MINUTE=20
RATE_LIMIT_SFU_WS_PER_MINUTE=20
RATE_LIMIT_SFU_MSG_PER_MINUTE=120

# ============================================
# Frontend build args / local development
# ============================================
VITE_API_HOST=http://localhost:8080
VITE_SFU_HOST=http://localhost:8081
NPM_REGISTRY=
GOPROXY=https://proxy.golang.org,direct

# ============================================
# Production checklist
# ============================================
# - Set GO_ENV=production.
# - Replace JWT_SECRET, SFU_JWT_SECRET, SFU_CONTROL_TOKEN, SFU_CALLBACK_TOKEN.
# - Replace DB_PASSWORD, COTURN_PASSWORD, TURN_STATIC_AUTH_SECRET.
# - Set ALLOWED_ORIGINS to your HTTPS frontend origins.
# - Serve API/SFU/frontend through HTTPS/WSS reverse proxy.
# - Keep SFU_ALLOW_UNAUTHENTICATED_DEV=false.

# ============================================
# SFU cluster (多实例) / recordings / uploads
# ============================================
# 面向浏览器公开的本实例 WS 地址（API 据此下发 sfu_url；为空时前端回退 VITE_SFU_HOST）
SFU_PUBLIC_WS_URL=ws://localhost:8081
# 录制目录（非空启用会议录制：VP8→IVF / Opus→OGG / 其他→RTP dump）
SFU_RECORDING_DIR=
# 聊天图片/文件上传目录与大小上限（字节，默认 20MB）
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=20971520
# 信令断线宽限期（秒）：超过该时间未重连才在服务端标记离开
PRESENCE_GRACE_SECONDS=90
