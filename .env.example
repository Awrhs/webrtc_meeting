# ============================================
# Runtime
# ============================================
GO_ENV=development
SERVER_PORT=8080
SFU_PORT=8081
SFU_GRPC_PORT=50051
SFU_ADDR=localhost:50051
API_SERVER_HOST=http://localhost:8080

# ============================================
# Database (PostgreSQL)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=conference

# ============================================
# Redis
# ============================================
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# ============================================
# JWT / SFU Auth
# Production must use strong independent random values.
# ============================================
JWT_SECRET=your-secret-key-change-in-production
SFU_JWT_SECRET=your-sfu-secret-key-change-in-production
SFU_CONTROL_TOKEN=dev-sfu-control-token
SFU_CALLBACK_TOKEN=dev-sfu-callback-token
JWT_EXPIRY_HOURS=168
SFU_TOKEN_EXPIRY_MINUTES=5

# ============================================
# CORS / WebSocket Origins
# Comma-separated exact origins. Do not use * in production.
# ============================================
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1
SFU_ALLOW_UNAUTHENTICATED_DEV=false

# ============================================
# STUN/TURN（下发给浏览器的 ICE 配置）
# STUN_URLS：逗号分隔，设为 none 表示不用 STUN（纯内网/无外网部署，避免每次入会白等几秒）
# TURN_URLS：浏览器能访问到的 coturn 地址，如 turn:192.168.1.10:3478?transport=udp
# TURN 凭据为 REST 时限模式：API 与 coturn 共用 TURN_STATIC_AUTH_SECRET，前端不再持有固定账号密码
# COTURN_URL/COTURN_USER/COTURN_PASSWORD 仅用于兼容旧的固定账号模式（未配置 TURN_URLS 时）
# ============================================
STUN_URLS=stun:stun.qq.com:3478,stun:stun.miwifi.com:3478
TURN_URLS=
TURN_STATIC_AUTH_SECRET=dev-turn-secret-change-in-production
TURN_CREDENTIAL_TTL_SECONDS=3600
TURN_REALM=conference
# coturn 对外 IP（局域网为宿主机 IP）；docker-compose.tls.yml 默认取 PUBLIC_HOST
TURN_EXTERNAL_IP=
COTURN_URL=turn:localhost:3478
COTURN_USER=username
COTURN_PASSWORD=password

# SFU 媒体 UDP 端口段（compose 会原样发布到宿主机；云主机安全组需放行同一区间）
WEBRTC_PORT_RANGE_MIN=49152
WEBRTC_PORT_RANGE_MAX=49200
# SFU 对外可达的 IP（局域网：宿主机 IP；云主机：弹性公网 IP），逗号分隔可多个
SFU_PUBLIC_IP=
# HTTPS 部署（docker-compose.tls.yml）对外访问地址：局域网 IP 或域名
PUBLIC_HOST=

# ============================================
# HTTP lifecycle
# ============================================
HTTP_READ_TIMEOUT_SECONDS=10
HTTP_WRITE_TIMEOUT_SECONDS=10
SHUTDOWN_TIMEOUT_SECONDS=15

# ============================================
# Rate limits
# ============================================
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_WS_PER_MINUTE=20
RATE_LIMIT_SFU_WS_PER_MINUTE=20
RATE_LIMIT_SFU_MSG_PER_MINUTE=600

# ============================================
# Frontend build args / local development
# ============================================
VITE_API_HOST=http://localhost:8080
VITE_SFU_HOST=http://localhost:8081
NPM_REGISTRY=
GOPROXY=https://proxy.golang.org,direct

# ============================================
# Production checklist
# ============================================
# - Set GO_ENV=production.
# - Replace JWT_SECRET, SFU_JWT_SECRET, SFU_CONTROL_TOKEN, SFU_CALLBACK_TOKEN.
# - Replace DB_PASSWORD, COTURN_PASSWORD, TURN_STATIC_AUTH_SECRET.
# - Set ALLOWED_ORIGINS to your HTTPS frontend origins.
# - Serve API/SFU/frontend through HTTPS/WSS reverse proxy.
# - Keep SFU_ALLOW_UNAUTHENTICATED_DEV=false.

# ============================================
# SFU cluster (多实例) / recordings / uploads
# ============================================
# 面向浏览器公开的本实例 WS 地址（API 据此下发 sfu_url；为空时前端回退 VITE_SFU_HOST）
SFU_PUBLIC_WS_URL=ws://localhost:8081
# 录制目录（非空启用会议录制：VP8→IVF / Opus→OGG / 其他→RTP dump）
# 注意：客户端开启媒体 E2EE 时，SFU 录到的是密文，无法直接回放
SFU_RECORDING_DIR=
# API 访问 SFU HTTP 接口（录制列表/下载代理）的地址；Docker 内为 http://sfu-server:8081
SFU_HTTP_URL=http://localhost:8081

# ============================================
# 可观测性：API 与 SFU 都在 /metrics 暴露 Prometheus 文本指标
# METRICS_TOKEN 非空时抓取需携带 Authorization: Bearer <token>（Prometheus bearer_token）
# ============================================
METRICS_TOKEN=
# 聊天图片/文件上传目录与大小上限（字节，默认 20MB）
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=20971520
# 信令断线宽限期（秒）：超过该时间未重连才在服务端标记离开
PRESENCE_GRACE_SECONDS=90

# ============================================
# 邮件（找回密码 / 邮箱验证的验证码）
# MAIL_PROVIDER=log：不真正发信，验证码打到服务端日志（开发、局域网试用够用）
# MAIL_PROVIDER=smtp：通过 SMTP 发信（QQ 邮箱、Gmail 等均可；SMTP_TLS_MODE：starttls=587 / implicit=465 / none=仅本机调试）
# REQUIRE_EMAIL_VERIFICATION=true 时新用户必须先验证邮箱才能登录（生产环境需 MAIL_PROVIDER=smtp）
# ============================================
MAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=starttls
REQUIRE_EMAIL_VERIFICATION=false
APP_NAME=SFU会议
