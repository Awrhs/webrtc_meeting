FROM golang:1.24-alpine AS builder

ARG GOPROXY=https://proxy.golang.org,direct
ENV GO111MODULE=on \
    GOPROXY=${GOPROXY}

RUN apk --no-cache add ca-certificates git

WORKDIR /app

COPY go.mod ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o sfu ./backend/cmd/sfu

FROM alpine:latest

RUN apk --no-cache add ca-certificates

WORKDIR /root/

COPY --from=builder /app/sfu .

EXPOSE 8081

ENV GO_ENV=production

CMD ["./sfu"]
