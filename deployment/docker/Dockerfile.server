FROM golang:1.24-alpine AS builder

ARG GOPROXY=https://proxy.golang.org,direct
ENV GO111MODULE=on \
    GOPROXY=${GOPROXY}

RUN apk --no-cache add ca-certificates git

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o server ./backend/cmd/server

FROM alpine:3.20

RUN apk --no-cache add ca-certificates tzdata \
    && adduser -D -u 10001 app \
    && mkdir -p /data/uploads \
    && chown -R app:app /data

WORKDIR /app
COPY --from=builder /app/server .

# 以非 root 运行；/data/uploads 的属主在镜像里设好，首次创建的命名卷会继承
USER app
EXPOSE 8080
ENV GO_ENV=production

CMD ["./server"]
