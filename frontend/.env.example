# ============================================
# Local Development (Native)
# ============================================
# VITE_API_HOST=http://localhost:8080
# VITE_SFU_HOST=http://localhost:8081

# ============================================
# WSL2 Development
# ============================================
# Get WSL2 IP from Windows PowerShell: `wsl hostname -I`
# Then use that IP below
# VITE_API_HOST=http://172.25.24.77:8080
# VITE_SFU_HOST=http://172.25.24.77:8081

# ============================================
# Docker Development
# ============================================
VITE_API_HOST=http://localhost:8080
VITE_SFU_HOST=http://localhost:8081

# WebRTC 配置
VITE_STUN_SERVER=stun:stun.l.google.com:19302

# TURN 服务器配置（可选，用于 NAT 穿透）
# VITE_TURN_SERVER=turn:your-turn-server.com:3478
# VITE_TURN_USERNAME=your-username
# VITE_TURN_CREDENTIAL=your-password

# 注意：VITE_ENCRYPTION_KEY 已废弃，现在使用动态 ECDH 密钥交换
# 不再需要全局加密密钥
